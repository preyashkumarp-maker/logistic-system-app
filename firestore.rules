rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Authenticated users can read all parcels and drivers
    match /parcels/{parcelId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'user');
      
      // Allow drivers to read their assigned parcels
      match /events/{eventId} {
        allow read, write: if request.auth != null;
      }
    }

    match /parcelTracking/{parcelId} {
      allow read: if request.auth != null;
      match /events/{eventId} {
        allow read, write: if request.auth != null;
      }
    }

    // Authenticated users can read drivers
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.uid == driverId);
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}