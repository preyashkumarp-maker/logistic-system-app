rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // The app has no server-side custom-claims mechanism (no Cloud Functions),
    // so roles live only in each user's Firestore profile, not the auth token.
    // Any signed-in app user (admin/dispatcher) can manage parcels and drivers.
    match /parcels/{parcelId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();

      // Allow drivers to read their assigned parcels
      match /events/{eventId} {
        allow read, write: if isSignedIn();
      }
    }

    match /parcelTracking/{parcelId} {
      allow read: if isSignedIn();
      match /events/{eventId} {
        allow read, write: if isSignedIn();
      }
    }

    // Authenticated users can read and manage drivers
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}